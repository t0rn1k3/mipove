# Copy to `.env.local` for local overrides (not committed).
# See docs/ga4.md for GA4 verification steps.

# Site URL (metadata, API client origin helpers)
NEXT_PUBLIC_FRONTEND_URL=

# Backend API base (must end with /api if your client expects that)
NEXT_PUBLIC_API_URL= 

# Optional: extra hostnames for next/image remotePatterns (comma-separated)
# NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=

# Google Analytics 4 — public measurement ID (G-XXXXXXXXXX). Omit or leave empty to disable.
# Not loaded in `next dev` so local browsing does not pollute production property.
NEXT_PUBLIC_GA_MEASUREMENT_ID= 
